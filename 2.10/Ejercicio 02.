#include <iostream>
using namespace std;

int main() {
    double combustible = 50.0;
    double consumido = 0.0;
    double totalConsumido = 0.0;
    int entregas = 0;

    while (combustible > 10.0) {
        cout << "Combustible actual: " << combustible << " litros." << endl;
        cout << "Ingrese los litros consumidos en la entrega: ";
        cin >> consumido;

        if (consumido < 0) {
            cout << "Cantidad invalida. Ingrese un valor positivo." << endl;
            continue;
        }

        combustible -= consumido;
        totalConsumido += consumido;
        entregas++;
    }

    cout << "\n--- Informe ---" << endl;
    cout << "Cantidad de entregas realizadas: " << entregas << endl;
    cout << "Total de combustible consumido: " << totalConsumido << " litros" << endl;
    cout << "Combustible restante: " << combustible << " litros" << endl;
    cout << "Debe cargar combustible" << endl;

    return 0;
}
