Enunciado. Leer un número entero positivo N y determinar: la cantidad total de dígitos que contiene, la cantidad de dígitos mayores a 5 y la suma de los dígitos mayores a 5.
Ejemplo:
N = 583726
Dígitos: 5  8  3  7  2  6
Dígitos mayores a 5: 8  7  6
Cantidad total de dígitos: 6
Cantidad de dígitos mayores a 5: 3
Suma de los dígitos mayores a 5: 21

#include <iostream>

using namespace std;

int main() {
    int N, temp, totalDigitos, digitosMayoresA5, sumaMayoresA5;
    
    cout << "Ingrese un numero entero positivo N: ";
    cin >> N;

    if (N <= 0) {
        cout << "El numero debe ser positivo." << endl;
        return 1;
    }

    temp = N;
    totalDigitos = 0;
    digitosMayoresA5 = 0;
    sumaMayoresA5 = 0;

    while (temp > 0) {
        int digito = temp % 10;
        totalDigitos++;

        if (digito > 5) {
            digitosMayoresA5++;
            sumaMayoresA5 += digito;
        }

        temp = temp/10;
    }

    cout << "\n--- RESULTADOS ---" << endl;
    cout << "Cantidad total de digitos: " << totalDigitos << endl;
    cout << "Cantidad de digitos mayores a 5: " << digitosMayoresA5 << endl;
    cout << "Suma de los digitos mayores a 5: " << sumaMayoresA5 << endl;

    return 0;
}
