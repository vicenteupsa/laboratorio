#include <iostream>
#include <string>

using namespace std;

int main(){
    
    string nombre;
    double m3, tarifa, total;
    
    cout <<"Ingrese su nombre: " ;
    getline(cin, nombre);
    
    cout <<"ingrese su consumo: " ;
    cin >> m3;
    
    if (m3>=0 && m3<=15){
        tarifa = 1.2 ;
        cout << "Consumo Minimo";
    }
    else if (m3>15 && m3<=35){
        tarifa = 2.5 ;
        cout << "Consumo Domestico";
    }
    else if (m3>35 && m3<=70){
        tarifa = 4 ;
